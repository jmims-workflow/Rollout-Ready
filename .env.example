ANTHROPIC_API_KEY=
ROLLOUT_MODE=demo
ROLLOUT_JUDGE_MODEL=claude-sonnet-5-5
# Optional. Signs the cookie that keeps demo overrides for a browser session.
# If unset, a random key is made each time the server starts.
ROLLOUT_SECRET_KEY=
# Optional. Open live mode to anyone, with private sessions and the limits below.
ROLLOUT_PUBLIC=false
ROLLOUT_MAX_RUNS_PER_SESSION=3
ROLLOUT_MAX_RUNS_PER_IP_PER_DAY=5
ROLLOUT_MAX_RUNS_PER_DAY=10
# Where visitor sessions, shared demo results and usage counts are kept. Defaults to the temp folder.
ROLLOUT_DATA_DIR=
